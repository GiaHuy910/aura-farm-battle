cabal-version:      3.0
name:               server
version:            0.1.0.0
build-type:         Simple

-- 1. LIBRARY: Nơi chứa toàn bộ code logic để cả file App và file Test dùng chung
library
    hs-source-dirs:   app
    exposed-modules:  App
                    , Seed.SkillSeed
                    , Seed.ClotheSeed
                    , Seed.GiftcodeSeed
                    , Config.Database
                    , Config.GameConfig
                    , Config.ServerConfig
                    , Controllers.AuthController
                    , Controllers.RoomController
                    , Controllers.UserController
                    , Controllers.PoolController
                    , Controllers.GachaHistoryController
                    , Controllers.GiftcodeController
                    , Controllers.WsController
                    , Model.Clothe
                    , Model.Rooms
                    , Model.Session
                    , Model.Skill
                    , Model.User
                    , Model.GachaHistory
                    , Model.Match
                    , Model.Inventory
                    , Model.Giftcode
                    , Route.AuthRouter
                    , Route.Index
                    , Route.RoomRouter
                    , Route.UserRouter
                    , Route.PoolRouter
                    , Route.GachaHistoryRouter
                    , Route.GiftcodeRouter
                    , Route.WsRouter
                    , Service.WsService
                    , Service.RoomView
                    , Service.RematchService
                    , Service.RewardService
                    , Service.GiftcodeService
                    , Service.BattleService
                    , Ws.Env
                    , Ws.Hub
                    , Ws.MongoStore
                    , Ws.Message
                    , Ws.Types
                    , Game.Config
                    , Game.Random
                    , Game.Types
                    , Game.Strategy
                    , Game.Rules
                    , Game.View
                    , Game.Registry
    build-depends:
        base ^>=4.19.1.0 && <4.21,
        aeson,
        servant-server,
        servant-websockets,
        websockets,
        warp,
        wai,
        wai-cors,
        mongoDB,
        uuid,
        password,
        text,
        bson,
        time,
        random,
        stm,
        bytestring,
        containers,
        cookie,
        dotenv
    default-language: Haskell2010
    ghc-options: -Wall

    

-- 2. EXECUTABLE: Chạy API Server chính
executable server-app
    main-is:          Server.hs
    hs-source-dirs:   src
    other-modules:
    build-depends:
        base ^>=4.19.1.0,
        server,
    default-language: Haskell2010
    ghc-options: -Wall -threaded
test-suite server-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:
        base >= 4.14 && < 5,
        server,
        hspec,
        QuickCheck,
        random,
        aeson,
        mongoDB,
        text,
        containers,
        time
    default-language: Haskell2010
    ghc-options: -Wall