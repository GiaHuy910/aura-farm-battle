cabal-version:      3.0
name:               server
version:            0.1.0.0
build-type:         Simple

-- 1. LIBRARY: Nơi chứa toàn bộ code logic để cả file App và file Test dùng chung
library
    hs-source-dirs:   app
    exposed-modules:  
                      Config.Database
                    , Controllers.AuthController
                    , Controllers.RoomController
                    , Controllers.UserController
                    , Controllers.PoolController
                    , Model.Clothe
                    , Model.Rooms
                    , Model.Session
                    , Model.Skill
                    , Model.User
                    , Route.AuthRouter
                    , Route.Index
                    , Route.RoomRouter
                    , Route.UserRouter
                    , Route.PoolRouter
    build-depends:
        base ^>=4.19.1.0 && <4.21,
        aeson,
        servant-server,
        warp,
        wai,
        wai-cors,
        mongoDB,
        uuid,
        password,
        text,
        bson,
        time,
        random
    default-language: Haskell2010
    ghc-options: -Wall

-- 2. EXECUTABLE: Chạy API Server chính
executable server-app
    main-is:          Server.hs
    hs-source-dirs:   app
    other-modules:  
        Config.Database
        , Controllers.AuthController
        , Controllers.RoomController
        , Controllers.UserController
        , Controllers.PoolController
        , Model.Clothe
        , Model.Rooms
        , Model.Session
        , Model.Skill
        , Model.User
        , Route.AuthRouter
        , Route.Index
        , Route.RoomRouter
        , Route.UserRouter
        , Route.PoolRouter
    build-depends:
        base ^>=4.19.1.0,
        server,
        aeson,
        servant-server,
        warp,
        wai,
        wai-cors,
        mongoDB,
        uuid,
        password,
        text,
        bson,
        time,
        random
    default-language: Haskell2010
    ghc-options: -Wall
