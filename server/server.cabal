cabal-version:      3.0
name:               server
version:            0.1.0.0
build-type:         Simple

-- 1. LIBRARY: Nơi chứa toàn bộ code logic để cả file App và file Test dùng chung
library
    hs-source-dirs:   app
    exposed-modules:  App
                    , Seed.SkillSeed
                    , Seed.ClotheSeed
                    , Config.Database
                    , Config.GameConfig
                    , Config.ServerConfig
                    , Controllers.AuthController
                    , Controllers.RoomController
                    , Controllers.UserController
                    , Controllers.PoolController
                    , Controllers.GachaHistoryController
                    , Controllers.WsController
                    , Model.Clothe
                    , Model.Rooms
                    , Model.Session
                    , Model.Skill
                    , Model.User
                    , Model.GachaHistory
                    , Route.AuthRouter
                    , Route.Index
                    , Route.RoomRouter
                    , Route.UserRouter
                    , Route.PoolRouter
                    , Route.GachaHistoryRouter
                    , Route.WsRouter
                    , Service.WsService
                    , Ws.Env
                    , Ws.Hub
                    , Ws.MongoStore
                    , Ws.Message
                    , Ws.Types
    build-depends:
        base ^>=4.19.1.0 && <4.21,
        aeson,
        servant-server,
        servant-websockets,
        websockets,
        warp,
        wai,
        wai-cors,
        mongoDB,
        uuid,
        password,
        text,
        bson,
        time,
        random,
        stm,
        bytestring,
        containers,
        cookie,
        dotenv
    default-language: Haskell2010
    ghc-options: -Wall
    

-- 2. EXECUTABLE: Chạy API Server chính
executable server-app
    main-is:          Server.hs
    hs-source-dirs:   src
    other-modules:
    build-depends:
        base ^>=4.19.1.0,
        server,
    default-language: Haskell2010
    ghc-options: -Wall -threaded
